{
  "name": "babylon-lite-astra-blender-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run test:tooling && npm run build",
    "test:tooling": "node --test tests/openspec-tooling.mjs",
    "spec": "node scripts/openspec.mjs",
    "spec:validate": "node scripts/openspec.mjs validate --all --strict",
    "blender": "node scripts/blender.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.25.0",
    "@babylonjs/loaders": "9.25.0"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.12.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
